# ==========================================
# Backend .gitignore (Node.js / Express)
# ==========================================

# Dependencies
node_modules/

# Environment configurations
.env
.env.*
!.env.example

# Application logs & debug files
log/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User-uploaded files (keep directory via .gitkeep)
uploads/*
!uploads/.gitkeep

# Database backups
backups/

# Operating System Files
.DS_Store
Thumbs.db
