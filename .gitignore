# ==========================================
# Git Ignore Configuration - Maison Élégance
# Backend: Node.js / Express | Frontend: Angular
# ==========================================

# ------------------------------------------
# General & System
# ------------------------------------------
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# IDE & Editors
# ------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# Dependencies & Build Outputs (All Subfolders)
# ------------------------------------------
node_modules/
dist/
coverage/
.angular/

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
.env.local
backend/.env
Backend/.env
backend/.env.*
Backend/.env.*
frontend/.env
frontend/.env.*

# Keep example files
!.env.example
!backend/.env.example
!Backend/.env.example
!frontend/.env.example

# ------------------------------------------
# Backend Storage & Logs
# ------------------------------------------
backend/log/
Backend/log/
backend/logs/
Backend/logs/
backend/backups/
Backend/backups/
backend/uploads/*
Backend/uploads/*
!backend/uploads/.gitkeep
!Backend/uploads/.gitkeep

# ------------------------------------------
# Git Exceptions
# ------------------------------------------
!.gitkeep